<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x500_description</name>
  <version>0.1.0</version>
  <description>
    Holybro X500 quadcopter description: URDF/xacro, meshes and RViz config.
    Pure description - no Gazebo/simulator code (that lives in x500_gazebo).
  </description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernández Cordero</maintainer>
  <maintainer email="bbingham@honurobotics.com">Brian Bingham</maintainer>
  <maintainer email="caguero@honurobotics.com">Carlos Agüero</maintainer>
  <maintainer email="jrivero@honurobotics.com">Jose Luis Rivero</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <url type="website">https://honurobotics.github.io/holybro_models/</url>
  <url type="repository">https://github.com/HonuRobotics/holybro_models</url>
  <url type="bugtracker">https://github.com/HonuRobotics/holybro_models/issues</url>
  <author email="caguero@honurobotics.com">Carlos Agüero</author>
  <author>Honu Robotics</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>xacro</buildtool_depend>
  <depend>holybro_parts</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>liburdfdom-tools</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
