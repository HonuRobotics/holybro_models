<?xml version="1.0"?>
<!--
  X500 accessory macros + a recursive dispatcher that mounts the accessories
  listed in config/x500.yaml. Each accessory is a link (sized primitive
  placeholder) fixed to the parent at the config pose. Masses matter here: the
  base_link is the bare airframe, so the battery + payload accessories make up the
  rest of the all-up weight (see the mass note in x500.urdf.xacro). Meshes/sizes
  are temporary placeholders; type names MUST match the config's `type`.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===== helpers ===== -->
  <!-- Inertia tensors follow from the primitive geometry and the mass, so
       they track the placeholder dimensions automatically. -->
  <xacro:macro name="_box_accessory" params="name xyz rpy parent size mass:=0.1">
    <xacro:property name="d" value="${[float(v) for v in size.split()]}"/>
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${float(mass)/12.0 * (d[1]**2 + d[2]**2)}" ixy="0" ixz="0"
                 iyy="${float(mass)/12.0 * (d[0]**2 + d[2]**2)}" iyz="0"
                 izz="${float(mass)/12.0 * (d[0]**2 + d[1]**2)}"/>
      </inertial>
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="0.2 0.2 0.22 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ===== accessories (dims from product pages; swap for real meshes) ===== -->
  <!-- 4S LiPo pack: the largest movable mass / biggest CG lever. -->
  <xacro:macro name="battery" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.145 0.048 0.038" mass="0.45"/>
  </xacro:macro>

  <!-- Companion computer (RPi4 / Jetson-class) on the payload plate. -->
  <xacro:macro name="companion_computer" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.090 0.060 0.020" mass="0.12"/>
  </xacro:macro>

  <!-- Gimbal / payload camera (A8-mini class) slung below/forward. -->
  <xacro:macro name="gimbal" params="name xyz rpy parent:=base_link">
    <xacro:_box_accessory name="${name}" xyz="${xyz}" rpy="${rpy}" parent="${parent}"
                          size="0.055 0.057 0.075" mass="0.15"/>
  </xacro:macro>

  <!-- GPS/RTK on a mast: thin mast + puck on top. One parametric mount covers the
       whole M8N->M10->F9P family (retune mass/height per module). -->
  <xacro:macro name="gps_mast" params="name xyz rpy parent:=base_link">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <mass value="0.05"/>
        <!-- Slender mast (r 5 mm, l 0.12 m) about its centre; puck negligible. -->
        <inertia ixx="${0.05/12.0 * (3*0.005**2 + 0.12**2)}" ixy="0" ixz="0"
                 iyy="${0.05/12.0 * (3*0.005**2 + 0.12**2)}" iyz="0"
                 izz="${0.05/2.0 * 0.005**2}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry><cylinder radius="0.005" length="0.12"/></geometry>
        <material name="${name}_mast"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
        <geometry><cylinder radius="0.028" length="0.018"/></geometry>
        <material name="${name}_puck"><color rgba="0.85 0.85 0.85 1"/></material>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- ===== recursive dispatcher: mount each config accessory by type =====
       The config `type` IS the macro name, invoked directly; an unknown type
       fails the build loudly instead of silently mounting nothing. -->
  <xacro:macro name="mount_accessories" params="items parent:=base_link">
    <xacro:if value="${len(items) > 0}">
      <xacro:property name="a" value="${items[0]}"/>
      <xacro:call macro="${a['type']}" name="${a['name']}"
                  xyz="${a['xyz']}" rpy="${a['rpy']}" parent="${parent}"/>
      <xacro:mount_accessories items="${items[1:]}" parent="${parent}"/>
    </xacro:if>
  </xacro:macro>

</robot>
