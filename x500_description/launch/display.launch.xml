<?xml version="1.0"?>
<!--
  Visualize the X500 description in RViz: robot_state_publisher (build-time URDF),
  joint_state_publisher_gui (sliders to spin the four rotors) and RViz with the
  packaged config. Pure ROS/description - no Gazebo.
-->
<launch>
  <arg name="gui" default="true"
       description="Start joint_state_publisher_gui to drive the rotor joints."/>
  <arg name="config_file"
       default="$(find-pkg-share x500_description)/config/x500.yaml"
       description="Vehicle config (accessories) expanded at launch."/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher">
    <!-- type="str": keep launch from running yaml type-inference over the URDF. -->
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share x500_description)/urdf/x500.urdf.xacro config_file:=$(var config_file)')"
           type="str"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui" if="$(var gui)"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share x500_description)/rviz/x500.rviz"/>
</launch>
