<?xml version="1.0"?>
<!--
  companion_computer part macro: a companion computer (RPi 4 / Jetson class) on the payload plate.

  Visual: models/companion_computer/companion_computer_visual.glb, a
  Raspberry Pi 5 on 6 mm standoffs, its ports toward the rear. Its datum, the
  part frame, is the center of the 58 x 49 mm hole pattern on the standoffs'
  lower faces; the board sits above it, so the inertia and the collision box
  sit above the datum. Mass and pose matter: accessories set the vehicle
  center of gravity.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="companion_computer_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="companion_computer"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">
    <xacro:companion_computer_info/>
    <xacro:property name="_d" value="${[0.09, 0.06, 0.02]}"/>
    <xacro:property name="_m" value="0.12"/>

    <link name="${name}">
      <inertial>
        <origin xyz="0 0 ${_d[2]/2}" rpy="0 0 0"/>
        <mass value="${_m}"/>
        <inertia ixx="${_m/12.0 * (_d[1]**2 + _d[2]**2)}" ixy="0" ixz="0"
                 iyy="${_m/12.0 * (_d[0]**2 + _d[2]**2)}" iyz="0"
                 izz="${_m/12.0 * (_d[0]**2 + _d[1]**2)}"/>
      </inertial>
      <xacro:part_visual mesh="package://holybro_parts/models/companion_computer/companion_computer_visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <!-- The visual's extent: board, cooler and the ports reaching back. -->
          <origin xyz="-0.01125 0 0.0116" rpy="0 0 0"/>
          <geometry><box size="0.0875 0.057 0.0232"/></geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
