<?xml version="1.0"?>
<!--
  gps_mast part macro: a GPS/RTK module on a mast: thin mast plus puck on top. One parametric mount covers the M8N to M10 to F9P family (retune mass/height per module).

  Visual: models/gps_mast/gps_mast_visual.glb, a folding GPS mast modeled
  from the kit's measured sizes with an M10 puck (50 mm, 14.4 mm tall) on its
  tray. Its datum, the part frame, is the center of the base clamp's lower
  face on the mast axis, where it sits on the payload platform; the puck's
  lid is 0.147 m up.
  Mass and pose matter: accessories set the vehicle center of gravity.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
  Reference frames, as <name>_<frame>: antenna (the puck, where a
  simulator places the NavSat sensor).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="gps_mast_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
            antenna=dict(xyz='0 0 0.142', rpy='0 0 0'),
        ))}"/>
  </xacro:macro>

  <xacro:macro name="gps_mast"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">
    <xacro:gps_mast_info/>

    <link name="${name}">
      <inertial>
        <!-- 32 g puck at 0.14 m over an 18 g mount spread up the mast: the
             center of mass is about 0.10 m up. Treated as a slender rod of
             the mount's height about that point, puck included. -->
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="${0.05/12.0 * (3*0.005**2 + 0.147**2)}" ixy="0" ixz="0"
                 iyy="${0.05/12.0 * (3*0.005**2 + 0.147**2)}" iyz="0"
                 izz="${0.032/2.0 * 0.025**2}"/>
      </inertial>
      <xacro:part_visual mesh="package://holybro_parts/models/gps_mast/gps_mast_visual.glb"/>
      <xacro:if value="${collision}">
        <!-- Base clamp, mast and puck, as cylinders on the mast axis. -->
        <collision name="clamp">
          <origin xyz="0 0 0.0057" rpy="0 0 0"/>
          <geometry><cylinder radius="0.015" length="0.0186"/></geometry>
        </collision>
        <collision name="mast">
          <origin xyz="0 0 0.0705" rpy="0 0 0"/>
          <geometry><cylinder radius="0.0046" length="0.111"/></geometry>
        </collision>
        <collision name="puck">
          <origin xyz="0 0 0.1373" rpy="0 0 0"/>
          <geometry><cylinder radius="0.026" length="0.023"/></geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
