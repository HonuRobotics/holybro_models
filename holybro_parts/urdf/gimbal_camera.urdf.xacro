<?xml version="1.0"?>
<!--
  gimbal_camera part macro: a gimbal payload camera (A8 mini class) slung below and forward.

  Visual: models/gimbal_camera/gimbal_camera_visual.glb, a SIYI A8 mini
  (55 x 55 x 70 mm). Its datum, the part frame, is the center of the mounting
  plate's upper face, which bolts under the payload rails; the gimbal hangs
  below it, so the inertia and the collision box sit half its height down.
  Mass and pose matter: accessories set the vehicle center of gravity.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="gimbal_camera_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ))}"/>
  </xacro:macro>

  <xacro:macro name="gimbal_camera"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">
    <xacro:gimbal_camera_info/>
    <xacro:property name="_d" value="${[0.055, 0.057, 0.075]}"/>
    <xacro:property name="_m" value="0.15"/>

    <link name="${name}">
      <inertial>
        <origin xyz="0 0 ${-_d[2]/2}" rpy="0 0 0"/>
        <mass value="${_m}"/>
        <inertia ixx="${_m/12.0 * (_d[1]**2 + _d[2]**2)}" ixy="0" ixz="0"
                 iyy="${_m/12.0 * (_d[0]**2 + _d[2]**2)}" iyz="0"
                 izz="${_m/12.0 * (_d[0]**2 + _d[1]**2)}"/>
      </inertial>
      <xacro:part_visual mesh="package://holybro_parts/models/gimbal_camera/gimbal_camera_visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <!-- The visual's extent, mounting plate to the bottom of the head. -->
          <origin xyz="0 0 -0.0345" rpy="0 0 0"/>
          <geometry><box size="0.055 0.055 0.069"/></geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
