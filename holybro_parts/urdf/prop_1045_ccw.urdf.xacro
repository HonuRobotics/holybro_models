<?xml version="1.0"?>
<!--
  prop_1045_ccw part macro: a 1045 (10 x 4.5 inch) propeller with the
  rotating bell of its Holybro 2216 motor, the counter clockwise rotor of the X500
  quad X pair.

  Visuals: models/prop_1045_ccw/prop_1045_ccw_visual.glb and
  models/motor_2216/motor_2216_bell_visual.glb. Both datums are the prop
  seat on the rotation axis (the bell's top face, the hub's lower face),
  which is this part's frame; the airframe places the rotor slot there.
  Inertia, collision thickness and the drive constants are still PX4's
  BSD 3 Clause x500 values (models/LICENSE); identify them for the real
  2216 + 1045 pair.

  Contract (see parts.xacro): <part>_info exports the metadata (attach,
  slots, frames, drive); <part> instantiates the link, its mounting joint
  and its slot / frame links.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="prop_1045_ccw_info">
    <xacro:property name="part_info" scope="parent" value="${dict(
        attach='0 0 0',
        slots=dict(
        ),
        frames=dict(
        ),
        drive=dict(rotation='ccw', motor_constant=8.54858e-06, moment_constant=0.016,
                   max_rot_velocity=1000.0, time_constant_up=0.0125, time_constant_down=0.025,
                   rotor_drag_coefficient=8.06428e-05, rolling_moment_coefficient=1e-06,
                   velocity_slowdown_sim=10))}"/>
  </xacro:macro>

  <xacro:macro name="prop_1045_ccw"
               params="name parent xyz:='0 0 0' rpy:='0 0 0' collision:=true joint:=fixed axis:='0 0 1'">
    <xacro:prop_1045_ccw_info/>

    <link name="${name}">
      <inertial>
        <mass value="0.016076923076923075"/>
        <inertia ixx="2.6115851691700804e-05" ixy="0" ixz="0"
                 iyy="3.8464910483993325e-07" iyz="0" izz="2.649858234714004e-05"/>
      </inertial>
      <xacro:part_visual mesh="package://holybro_parts/models/motor_2216/motor_2216_bell_visual.glb"/>
      <xacro:part_visual mesh="package://holybro_parts/models/prop_1045_ccw/prop_1045_ccw_visual.glb"/>
      <xacro:if value="${collision}">
        <collision>
          <!-- The blade's span at hub height, along the part's Y like the visual. -->
          <origin xyz="0 0 0.006" rpy="0 0 0"/>
          <geometry>
            <box size="0.016923076923076923 0.254 0.0008461538461538462"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>

    <xacro:part_joint name="${name}" parent="${parent}" xyz="${xyz}" rpy="${rpy}"
                      joint="${joint}" axis="${axis}" attach="${part_info['attach']}"/>
    <xacro:part_slots name="${name}" items="${list(part_info['slots'].items())}"/>
    <xacro:part_frames name="${name}" items="${list(part_info['frames'].items())}"/>

  </xacro:macro>

</robot>
