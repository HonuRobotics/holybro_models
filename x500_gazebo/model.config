<?xml version="1.0"?>
<model>
  <name>x500</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Honu Robotics</name></author>
  <description>
    Simulation ready Holybro X500 quadcopter, generated from the vehicle
    config: the x500_description assembly plus rotor actuators and flight
    sensors, no control layer. Meshes are BSD 3 placeholders reused from
    PX4-gazebo-models (see holybro_parts/models/LICENSE).
  </description>
</model>
