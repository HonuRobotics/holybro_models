<?xml version="1.0"?>
<model>
  <name>X500</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>

  <author>
    <name>Carlos Agüero</name>
    <email>caguero@honurobotics.com</email>
  </author>

  <description>
    Simulation-ready Holybro X500 quadcopter: merges the x500_description base
    model and adds the Gazebo plugins (rotor actuators + flight sensors; no
    control). Pull it into a world via model://x500_gazebo, or spawn it with
    ros_gz_sim create. Meshes are BSD-3 placeholders reused from PX4-gazebo-models
    (see x500_description/ASSETS.md).
  </description>
</model>
