<?xml version="1.0"?>
<!--
  Simulation-ready Holybro X500 model, GENERATED from model.sdf.xacro at build
  time. Merge-includes the x500_description geometry and adds the Gazebo plugins:
  one MulticopterMotorModel per rotor (the actuator plant) + the flight sensors
  (IMU / air-pressure / magnetometer / NavSat). NO control layer (no autopilot /
  velocity controller / cmd wiring) - the motors idle until something publishes
  gz.msgs.Actuators on <namespace>/command/motor_speed. Motor constants + sensor
  noise are PX4's (BSD-3) x500 values. The sensor *system* plugins live in the
  world (x500_playground.sdf), like PX4's server.config.

  In a world:  <include><uri>model://x500_gazebo</uri></include>
-->
<sdf version="1.12" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="config_file"
             default="$(find x500_description)/config/x500.yaml"/>
  <xacro:property name="cfg" value="${xacro.load_yaml('$(arg config_file)')}"/>

  <!-- Topic namespace for the flight-sensor topics (the bridge config is
       generated from the same yaml, so gz and ROS sides stay in sync). -->
  <xacro:property name="topic_ns" value="${cfg.get('topic_namespace', 'x500')}"/>

  <!-- One rotor's motor model. ccw props take turningDirection ccw, cw take cw;
       thrust = motorConstant * (motorRotVel * rotorVelocitySlowdownSim)^2. -->
  <xacro:macro name="motor" params="number spin">
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>x500</robotNamespace>
      <jointName>rotor_${number}_joint</jointName>
      <linkName>rotor_${number}</linkName>
      <turningDirection>${spin}</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>${number}</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
  </xacro:macro>

  <model name="x500">
    <include merge="true">
      <uri>package://x500_description/urdf/x500.urdf</uri>
    </include>

    <!-- Joint states for the rotor joints, so robot_state_publisher can
         animate the props in RViz. Bridged to /joint_states. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>${topic_ns}/joint_states</topic>
    </plugin>

    <!-- Flight sensors on a body-fixed massless link at the CG (rigidly equal to
         being on base_link; data is reported in the base_link frame). Backends are
         the *-system plugins in the world. PX4 (BSD-3) noise values. -->
    <link name="flight_sensors">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1e-5</mass>
        <inertia>
          <ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz>
        </inertia>
      </inertial>

      <sensor name="imu" type="imu">
        <frame_id>base_link</frame_id>
        <topic>${topic_ns}/imu</topic>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="air_pressure" type="air_pressure">
        <frame_id>base_link</frame_id>
        <topic>${topic_ns}/air_pressure</topic>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer" type="magnetometer">
        <frame_id>base_link</frame_id>
        <topic>${topic_ns}/mag</topic>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="navsat" type="navsat">
        <frame_id>base_link</frame_id>
        <topic>${topic_ns}/gps</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <joint name="flight_sensors_joint" type="fixed">
      <parent>base_link</parent>
      <child>flight_sensors</child>
    </joint>

    <!-- Rotor actuators (quad-X): FR/RL ccw, FL/RR cw. -->
    <xacro:motor number="0" spin="ccw"/>
    <xacro:motor number="1" spin="ccw"/>
    <xacro:motor number="2" spin="cw"/>
    <xacro:motor number="3" spin="cw"/>
  </model>
</sdf>
